# วางไฟล์ .env ไว้ที่ fitbot-api/ หรือโฟลเดอร์แม่ (fitbot/) ก็ได้

# ฐานข้อมูล PostgreSQL บนเครื่อง (Homebrew)
FITBOT_DATABASE_URL=postgres:///fitbot?host=/tmp
# กุญแจเข้ารหัส token สร้างด้วย `fitbot keygen` ห้ามหาย ห้ามขึ้น GitHub
FITBOT_ENCRYPTION_KEY=

# OAuth client ของ Google Cloud (ประเภท Web application, redirect http://localhost:8765/callback)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_SECRET=

# LINE Messaging API (Channel access token แบบ long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# ใช้เฉพาะเครื่องมือ spike (M0)
SPIKE_REDIRECT_PORT=8765
SPIKE_TIMEZONE=Asia/Bangkok
